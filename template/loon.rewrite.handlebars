#!name = {{@package 'displayName'}} (Rewrite)
#!desc = {{inline (@package 'description')}}
#!openUrl = {{@package 'openUrl'}}
#!author = {{@package 'contributors'}}
#!homepage = {{@package 'homepage'}}
#!icon = {{@package 'icon'}}
#!tag = {{@package 'organizationName'}}
#!system = {{@package 'system'}}
#!date = {{now "yyyy-MM-dd HH:mm:ss"}}
#!system_version = {{ @package 'systemVersion'}}

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Rewrite]
# 🌤 WeatherKit.api.v1.availability.response
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ https://weatherkit.pages.dev/api/v1/availability/ header
# 🌤 WeatherKit.api.v2.weather.response
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ https://weatherkit.pages.dev/api/v2/weather/ header
# 🌤 WeatherKit.alertDetails.index.response
^https?:\/\/www\.qweather\.com\/\/?severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ 302 https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=zh-CN&party=qweather
^https?:\/\/www\.qweather\.com\/en\/severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ 302 https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=en-US&party=qweather
# 🌤 WeatherKit.api.v1.weatherAlerts.response
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts(\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&[^#]*)?)$ https://weatherkit.pages.dev/api/v1/weatherAlerts$1 header

[MITM]
hostname = weatherkit.apple.com, www.qweather.com
