name: 'WeatherKit-WK3'
description: '本机 WK3：美标 AQ、分钟雨、昨日对比、原生预警'
author: WeatherKit-WK3 contributors
homepage: https://github.com/patrickyanxxxxx/WeatherKit-WK3
icon: https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
rules:
- and:
    match:
    - domain_suffix:
        match: weatherkit.apple.com
    - protocol:
        match: QUIC
    - dest_port:
        match: '443'
    policy: REJECT-NO-DROP
- and:
    match:
    - or:
        match:
        - ip_cidr:
            match: 139.178.128.0/18
            no_resolve: true
        - ip_cidr:
            match: 144.178.0.0/19
            no_resolve: true
        - ip_cidr:
            match: 144.178.36.0/22
            no_resolve: true
        - ip_cidr:
            match: 144.178.48.0/20
            no_resolve: true
        - ip_cidr:
            match: 17.0.0.0/8
            no_resolve: true
        - ip_cidr:
            match: 192.35.50.0/24
            no_resolve: true
        - ip_cidr:
            match: 198.183.17.0/24
            no_resolve: true
        - ip_cidr:
            match: 205.180.175.0/24
            no_resolve: true
        - ip_cidr6:
            match: 2403:300::/32
            no_resolve: true
        - ip_cidr6:
            match: 2620:149::/32
            no_resolve: true
        - ip_cidr6:
            match: 2a01:b740::/32
            no_resolve: true
        - ip_cidr:
            match: 63.92.224.0/19
            no_resolve: true
        - ip_cidr:
            match: 65.199.22.0/23
            no_resolve: true
    - protocol:
        match: UDP
    - dest_port:
        match: '443'
    policy: REJECT-NO-DROP
- and:
    match:
    - or:
        match:
        - asn:
            match: '714'
            no_resolve: true
        - asn:
            match: '6185'
            no_resolve: true
    - protocol:
        match: QUIC
    policy: REJECT-DROP
- domain_suffix:
    match: weatherkit.apple.com
    policy: DIRECT
- domain:
    match: weather-analytics-events.apple.com
    policy: REJECT-DROP
- domain_suffix:
    match: tthr.apple.com
    policy: REJECT-DROP
- domain:
    match: tether.edge.apple
    policy: REJECT-DROP
compat_arguments: __WK3_COMPAT_ARGUMENTS__
compat_arguments_desc: __WK3_ARGUMENT_DESCRIPTION__
env_schema: __WK3_ENV_SCHEMA__
scriptings:
__WK3_SCRIPTINGS__

mitm:
  hostnames:
    includes:
    - weatherkit.apple.com
